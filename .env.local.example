# OCI Configuration for SOC Detection Rules
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# These override the hardcoded defaults in scripts/oci_config.py.
# Environment variables (OCI_TENANCY_ID, etc.) take highest priority.

OCI_TENANCY_ID=ocid1.tenancy.oc1..your-tenancy-ocid-here
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your-compartment-ocid-here

# Optional: OCI CLI profile name (default: DEFAULT)
# OCI_PROFILE=DEFAULT

# Optional: OCI region (default: from ~/.oci/config)
# OCI_REGION=us-phoenix-1

# Optional: longer Log Analytics field inventory timeout for large namespaces.
# OCI_LOG_ANALYTICS_READ_TIMEOUT_SECONDS=180

# Required before mutating scripts: exact OCI profile that must remain guarded.
# No customer or internal profile name is embedded in repository defaults.
OCI_PROTECTED_PROFILE=

# Optional profile-scoped overrides for multi-profile environments. Prefix each
# key with the uppercase selected profile so values cannot bleed across targets.
# <PROFILE>_OCI_TENANCY_ID=ocid1.tenancy.oc1..your-profile-tenancy-ocid
# <PROFILE>_OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your-profile-compartment-ocid
# <PROFILE>_LA_NAMESPACE=your-profile-la-namespace
# <PROFILE>_LOG_ANALYTICS_LOG_GROUP_ID=ocid1.loganalyticsloggroup.oc1.region.your-profile-log-group
