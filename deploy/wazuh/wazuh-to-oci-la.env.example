# wazuh-to-oci-la environment template — copy to /etc/wazuh-to-oci-la.env and fill in.
# chmod 600 the real file; it holds the indexer password. NEVER commit the filled copy.

# ── OCI Log Analytics target ────────────────────────────────────────────────
# OCI CLI/SDK profile to authenticate as (must have LA upload rights on the
# target tenancy/compartment). For instance-principal auth set OCI_AUTH_MODE
# instead and omit OCI_PROFILE.
OCI_PROFILE=cap
# OCI_AUTH_MODE=instance_principal
# OCI_REGION=eu-frankfurt-1
# Optional explicit LA identifiers (otherwise auto-resolved per profile):
# OCI_COMPARTMENT_ID=<COMPARTMENT_OCID>
# LA_NAMESPACE=<LA_NAMESPACE>
# LOG_ANALYTICS_LOG_GROUP_ID=<LOG_GROUP_OCID>

# ── Wazuh indexer (OpenSearch) — indexer pull mode ──────────────────────────
WAZUH_INDEXER_URL=https://<WAZUH_INDEXER_HOST>:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=<INDEXER_PASSWORD>
# Set to false only for self-signed lab certs; prefer pinning a CA bundle.
WAZUH_INDEXER_VERIFY_TLS=true

# ── Logging ─────────────────────────────────────────────────────────────────
OCI_LOG_LEVEL=INFO
OCI_RUN_ID=wazuh-forwarder
