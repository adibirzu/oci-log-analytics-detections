%% Title: Boundary-first raw and evidence troubleshooting workflow
%% Evidence: code-backed failure contracts and operator checks; provider verified = false; release accepted = false
%% Primary objects: 9
flowchart LR
  subgraph TRIAGE["Symptom"]
    symptom["Missing or delayed Splunk result"]
  end
  subgraph RAW["Raw route"]
    connector["Connector Hub state"]
    streaming["OCI Streaming lag"]
    oci_splunk["oci-splunk transport"]
  end
  subgraph EVIDENCE["Evidence route"]
    logan["Log Analytics query result"]
    trigger["Monitoring and Notifications state"]
    function_state["Function and checkpoint/DLQ state"]
  end
  subgraph DEST["Shared destination"]
    hec["Splunk HEC response"]
    search["Splunk search result"]
  end
  symptom -.->|"control: inspect raw route upstream"| connector
  connector -->|"telemetry: verify Connector Hub delivery"| streaming
  streaming -->|"telemetry: inspect lag and consumption"| oci_splunk
  oci_splunk -->|"telemetry: retry-safe raw batch"| hec
  symptom -.->|"control: verify bounded evidence query"| logan
  logan -->|"telemetry: inspect metric and notification"| trigger
  trigger -.->|"control: inspect invocation, checkpoint, and DLQ"| function_state
  function_state -->|"telemetry: retry-safe evidence batch"| hec
  hec -.->|"response: accepted and searchable"| search
