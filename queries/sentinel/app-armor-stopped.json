{
  "title": "app-armor-stopped",
  "description": "This query was originally published in the threat analytics report, Sysrv botnet evolution.\nSysrv is a Go-based botnet that targets both Windows and Linux servers, and steals resources to mine cryptocurrency.\nThe following query finds instances of the attacker attempting to stop the AppArmor network security service on devices running Linux.\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Command Line' like '*/bin/bash /tmp/*' and 'Command Line' like '*service apparmor stop*')",
