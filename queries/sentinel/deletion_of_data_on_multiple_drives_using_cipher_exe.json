{
  "title": "Deletion of data on multiple drives using cipher exe",
  "description": "This query checks for attempts to delete data on multiple drives using cipher.exe. This activity is typically done by ransomware to prevent recovery of data after encryption.\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Process Name' = 'cipher.exe') and ('Command Line' like '*/w*') | timestats span = 1minute distinctcount('Command Line') as CipherCount, unique('Command Line') as CipherList by Entity, 'Host Name (Server)' | where CipherCount > 1",
  "level": "medium",
