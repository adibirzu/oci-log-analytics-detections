  "title": "DetectTorrentUse",
  "description": "Custom detection to find use of torrenting software or browsing related to torrents.\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Network Logs' or 'Log Source' = 'SOC Sysmon Network Logs') and ('Request URL' like '*torrent*' or 'Request URL' like '*vuze*' or 'Request URL' like '*azureus*' or 'Request URL' like '*.tor' or 'Parent Process Name' like '*torrent*' or 'Parent Process Name' like '*vuze*' or 'Parent Process Name' like '*azureus*') | fields Time, 'Resource ID', Entity, 'Host Name (Server)', 'Parent Process Name', 'Request URL', 'Destination IP', 'Destination Port'",
