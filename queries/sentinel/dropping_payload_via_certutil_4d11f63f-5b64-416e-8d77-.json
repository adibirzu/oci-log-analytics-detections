{
  "title": "Dropping Payload via certutil",
  "description": "BazaCall campaign tricks users into calling a fake customer support center, and download a malicious Excel file which contains a macro to infect users' device with BazaLoader. This query searches for a copy of certutil.exe used by the macro.\n",
  "query": "'Log Source' = 'SOC Windows Sysmon Logs' and ('Parent Process Name' != 'certutil.exe') and ('Parent Process Name' != 'cmd.exe') and (('Command Line' like '*-urlcache*' and 'Command Line' like '*split*' and 'Command Line' like '*http*'))",
