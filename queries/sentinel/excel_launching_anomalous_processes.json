{
  "title": "Excel launching anomalous processes",
  "description": "Use this query to find Excel launching anomalous processes congruent with Qakbot payloads which contain additional markers from recent Qakbot executions.\nThe presence of such anomalous processes indicate that the payload was delivered and executed, though reconnaissance and successful implantation hasn't been completed yet.\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Parent Process Name' like '*excel.exe*' or 'Parent Process Name' = 'excel.exe') and ('Parent Process Name' in ('excel.exe', 'regsvr32.exe')) and ('Process Name' in ('regsvr32.exe', 'rundll32.exe')) and ('Command Line' like '*..\\\\*')",
