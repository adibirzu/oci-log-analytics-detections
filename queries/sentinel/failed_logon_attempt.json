{
  "title": "Failed Logon Attempt",
  "description": "Sample query to detect If there are more then 3 failed logon authentications on high value assets.\nUpdate DeviceName to reflect your high value assets.\nFor questions @MiladMSFT on Twitter or milad.aslaner@microsoft.com.\n",
  "query": "('Log Source' = 'Windows Security Events' or 'Log Source' = 'Windows Event Security Logs') and ('Host Name (Server)' in ('DeviceName1', 'DeviceName2')) and (Action = 'LogonFailed') | stats count as LogonFailures by 'Host Name (Server)', 'Logon Type', 'Command Line' | where LogonFailures > 3 | fields LogonFailures, 'Host Name (Server)', 'Logon Type', 'Command Line' | sort -LogonFailures",
  "level": "medium",
