{
  "title": "KNOTWEED-PE File Dropped in Color Profile Folder",
  "description": "'This query identifies modifications to COM registry keys to point to executable files in C:\\Windows\\System32\\spool\\drivers\\color\\'\n",
  "query": "'Log Source' = 'SOC Windows Sysmon Logs' and (Action = 'FileCreated') and ('Target Filename' like '*C:\\\\\\\\Windows\\\\\\\\System32\\\\\\\\spool\\\\\\\\drivers\\\\\\\\color\\\\\\\\*') and ('Process Name' like '*.exe' or 'Process Name' like '*.dll')",
