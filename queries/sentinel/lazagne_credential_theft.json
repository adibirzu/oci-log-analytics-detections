{
  "title": "LaZagne Credential Theft",
  "description": "LaZagne is a popular open-source tool used to recover passwords stored on a local computer. It has been used in ransomware attacks to steal credentials and escalate privileges. This query looks for the execution of LaZagne.\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Process Name' = 'reg.exe') and (('Command Line' like '*save*' and 'Command Line' like '*hklm*' and 'Command Line' like '*sam*')) | fields Entity, 'Host Name (Server)', Time, 'Process ID', 'Parent Process Name', 'Process ID', 'Process Name', 'Command Line'",
