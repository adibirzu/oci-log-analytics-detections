{
  "title": "LSASS Credential Dumping with Procdump",
  "description": "Detects the use of Procdump to dump credentials from LSASS memory.",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ((('Process Name' like '*procdump.exe*' or 'Process Name' like '*procdump64.exe*') and 'Command Line' like '*lsass*') or ('Command Line' like '*lsass.exe*' and ('Command Line' like '*-accepteula*' or 'Command Line' like '*-ma*')))",
