{
  "title": "Oracle suspicious command execution",
  "description": "The query searches process creation events that are indicative of an attacker spawning OS commands from an Oracle database.\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Parent Process Name' = 'oracle.exe') and (not('Process Name' in ('conhost.exe', 'oradim.exe')))",
