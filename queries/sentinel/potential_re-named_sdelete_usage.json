{
  "title": "Potential re-named sdelete usage",
  "description": "'This detection looks for command line parameters associated with the use of Sysinternals sdelete (https://docs.microsoft.com/sysinternals/downloads/sdelete) to delete multiple files on a host's C drive.\nA threat actor may re-name the tool to avoid detection and then use it for destructive attacks on a host.'\n",
  "query": "('Log Source' = 'Windows Security Events' or 'Log Source' = 'Windows Event Security Logs') and ('Event ID' = '4688') and ('Process Name' != 'sdelete.exe') and (('Command Line' like '*accepteula*' and 'Command Line' like '*-r*' and 'Command Line' like '*-s*' and 'Command Line' like '*-q*' and 'Command Line' like '*c:/*')) and (not ('Command Line' like '*sdelete*'))",
  "level": "low",
  "source_type": "microsoft_sentinel",
  "sentinel_id": "720d12c6-a08c-44c4-b18f-2236412d59b0",
