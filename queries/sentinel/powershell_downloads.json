{
  "title": "PowerShell Downloads",
  "description": "The query searches for PowerShell execution events that could involve a download.\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Process Name' in ('powershell.exe', 'powershell_ise.exe')) and ('Command Line' like '*Net.WebClient*' or 'Command Line' like '*DownloadFile*' or 'Command Line' like '*Invoke-WebRequest*' or 'Command Line' like '*Invoke-Shellcode*' or 'Command Line' like '*http*' or 'Command Line' like '*IEX*' or 'Command Line' like '*Start-BitsTransfer*' or 'Command Line' like '*mpcmdrun.exe*') | fields Time, 'Host Name (Server)', 'Parent Process Name', 'Process Name', 'Command Line' | sort -Time | head 100",
  "level": "medium",
  "source_type": "microsoft_sentinel",
  "sentinel_id": "3842e70d-45be-43b1-8206-4ebc4c305f34",
