{
  "title": "Qakbot email theft (1)",
  "description": "Use this query to find email stealing activities ran by Qakbot that will use \"ping.exe -t 127.0.0.1\" to obfuscate subsequent actions.\nEmail theft that occurs might be exfiltrated to operators and indicates that the malware completed a large portion of its automated activity without interruption.\n",
  "query": "'Log Source' = 'SOC Windows Sysmon Logs' and ('Parent Process Name' = 'ping.exe' and 'Command Line' = 'ping.exe -t 127.0.0.1' and 'Parent Process Name' in ('msra.exe', 'mobsync.exe') and 'Target Filename' like '*.eml')",
