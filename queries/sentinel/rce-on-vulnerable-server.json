{
  "title": "rce-on-vulnerable-server",
  "description": "This query was originally published in the threat analytics report, Sysrv botnet evolution.\nSysrv is a Go-based botnet that targets both Windows and Linux servers, and steals resources to mine cryptocurrency.\nThe following query finds instances of remote code execution on a vulnerable Linux server.\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Command Line' like '*php-cgi.exe*') and (('Command Line' like '*curl -fsSL*' and 'Command Line' like '*/ldr.sh*' and 'Command Line' like '*wget -q -O*'))",
