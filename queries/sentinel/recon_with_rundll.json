{
  "title": "Recon with Rundll",
  "description": "This query detects suspicious rundll.exe activity associated with Trickbot campaigns. \n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Network Logs' or 'Log Source' = 'SOC Sysmon Network Logs') and ('Parent Process Name' = 'rundll32.exe') and ('Command Line' like '*rundll32.exe*' and not ('Command Line' like '* *') and 'Command Line' != '') | timestats span = 5minute distinctcount('Destination IP') as DestinationIPCount, unique('Destination IP') as set_RemoteIP, unique('Request URL') as set_RemoteUrl, unique('Destination Port') as set_RemotePort by 'Command Line', Entity",
