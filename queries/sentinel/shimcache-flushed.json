{
  "title": "shimcache-flushed",
  "description": "This query searches for attempts to flush Shimcache, which may indicate anti-forensic or defense evasion activity by an attacker.\nAuthor: Vaasudev_Kala\nRef: https://blueteamops.medium.com/shimcache-flush-89daff28d15e\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Process Name' like '*Rundll32.exe*') and (((('Command Line' like '*ShimFlushCache*' or 'Command Line' like '*BaseFlushAppcompatCache*')) or (('Command Line' like '*#250*' or 'Command Line' like '*#46*') and ('Command Line' like '*apphelp.dll*' or 'Command Line' like '*kernel32.dll*'))))",
