{
  "title": "Stopping multiple processes using taskkill",
  "description": "This query checks for attempts to stop at least 10 separate processes using the taskkill.exe utility.\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Process Name' = 'taskkill.exe') | timestats span = 2minute distinctcount('Command Line') as taskKillCount, unique('Command Line') as TaskKillList by Entity | where taskKillCount > 10",
