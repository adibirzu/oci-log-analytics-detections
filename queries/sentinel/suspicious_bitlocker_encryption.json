{
  "title": "Suspicious Bitlocker Encryption",
  "description": "Looks for potential instances of bitlocker modifying registry settings to allow encryption, where it's executed via a .bat file.\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Process Name' = 'reg.exe' and 'Command Line' like '*EnableBDEWithNoTPM*' and ('Command Line' like '*true*' or 'Command Line' like '*1*')) and (('Command Line' like '*C:\\\\\\\\Windows\\\\\\\\*' and 'Command Line' like '*.bat*'))",
