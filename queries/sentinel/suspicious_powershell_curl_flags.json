{
  "title": "Suspicious PowerShell curl flags",
  "description": "Microsoft has observed attackers who have gained entry to an environment via the Log4J vulnerability utilizing uncommon PowerShell flags to communicate to command-and-control infrastructure.\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Process Name' = 'powershell.exe') and (('Command Line' like '*-met*' and 'Command Line' like '*POST*' and 'Command Line' like '*-Body*'))",
