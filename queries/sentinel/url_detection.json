{
  "title": "URL Detection",
  "description": "This query finds network communication to specific URL.\nPlease note that in line #7 it filters RemoteUrl using has operator, which looks for a \"whole term\" and runs faster.\nExample: RemoteUrl has \"microsoft\" matches \"www.microsoft.com\" but not \"microsoftonline.com\".\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Network Logs' or 'Log Source' = 'SOC Sysmon Network Logs') and ('Request URL' like '*microsoft.com*') | fields Time, 'Host Name (Server)', Entity, 'Resource ID' | sort -Time | head 100",
