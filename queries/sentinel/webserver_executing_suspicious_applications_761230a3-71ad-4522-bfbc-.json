  "title": "Webserver Executing Suspicious Applications",
  "description": "This query looks for common webserver process names and identifies any processes launched using a scripting language (cmd, powershell, wscript, cscript).\n",
  "query": "('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Parent Process Name' in ('w3wp.exe', 'httpd.exe')) and ('Process Name' in ('cmd.exe', 'powershell.exe', 'cscript.exe', 'wscript.exe', 'net.exe', 'net1.exe', 'ping.exe', 'whoami.exe')) | stats count as instances by 'Command Line', 'Target Filename', 'Host Name (Server)', Entity | sort instances",
