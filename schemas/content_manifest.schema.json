{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oci-logan.local/schemas/content_manifest.schema.json",
  "title": "OCI Log Analytics Content Import Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "generator",
    "content_digest",
    "summary",
    "surface_digests",
    "queries",
    "rules",
    "packs",
    "dashboards"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "const": "oci-log-analytics-detections-content"
    },
    "generator": {
      "const": "scripts/generate_content_manifest.py"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "summary": {
      "type": "object",
      "required": [
        "total_queries",
        "queries_by_surface",
        "total_rules",
        "rules_by_domain",
        "total_packs",
        "total_dashboards",
        "total_dashboard_widgets"
      ],
      "additionalProperties": false,
      "properties": {
        "total_queries": { "type": "integer", "minimum": 0 },
        "queries_by_surface": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "total_rules": { "type": "integer", "minimum": 0 },
        "rules_by_domain": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "total_packs": { "type": "integer", "minimum": 0 },
        "total_dashboards": { "type": "integer", "minimum": 0 },
        "total_dashboard_widgets": { "type": "integer", "minimum": 0 }
      }
    },
    "surface_digests": {
      "type": "object",
      "required": ["queries", "rules", "packs", "dashboards"],
      "additionalProperties": false,
      "properties": {
        "queries": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "rules": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "packs": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "dashboards": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "surface", "title", "level", "logsource_product", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "surface": { "enum": ["base", "apps", "hunting", "sentinel"] },
          "title": { "type": "string" },
          "level": { "type": "string" },
          "logsource_product": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "domain", "id", "title", "level", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "domain": { "type": "string" },
          "id": { "type": "string" },
          "title": { "type": "string" },
          "level": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "source_type", "path", "query_paths", "sha256"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "source_type": { "enum": ["hunting_pack", "pack_manifest", "threat_report_pack"] },
          "path": { "type": "string" },
          "query_paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "dashboards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source", "widget_count", "query_files", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "widget_count": { "type": "integer", "minimum": 0 },
          "query_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
