{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adibirzu/oci-log-analytics-detections/blob/main/schemas/siem_log_examples.schema.json",
  "title": "OCI SIEM Log Examples Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "placeholder_policy",
    "raw_log_samples",
    "detection_samples",
    "comparison"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "placeholder_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntax", "description"],
      "properties": {
        "syntax": {"const": "<UPPER_SNAKE_CASE>"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "raw_log_samples": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/rawLogSample"}
    },
    "detection_samples": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/detectionSample"}
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_path", "normalized_path", "advantages", "caution"],
      "properties": {
        "native_path": {"$ref": "#/$defs/nonEmptyStringArray"},
        "normalized_path": {"$ref": "#/$defs/nonEmptyStringArray"},
        "advantages": {"$ref": "#/$defs/nonEmptyStringArray"},
        "caution": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "rawLogSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "service",
        "category",
        "official_doc_url",
        "envelope_type",
        "repository_coverage",
        "repository_dataset",
        "description",
        "event"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "service": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "official_doc_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://docs\\.oracle\\.com/"
        },
        "envelope_type": {"type": "string", "minLength": 1},
        "repository_coverage": {"enum": ["envelope", "payload", "custom", "gap"]},
        "repository_dataset": {"type": ["string", "null"]},
        "description": {"type": "string", "minLength": 1},
        "event": {"type": "object"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "nativeAlarm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dedupeKey",
        "title",
        "body",
        "type",
        "severity",
        "timestampEpochMillis",
        "timestamp",
        "alarmMetaData",
        "version"
      ],
      "properties": {
        "dedupeKey": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "type": {"const": "OK_TO_FIRING"},
        "severity": {"enum": ["CRITICAL", "ERROR", "WARNING", "INFO"]},
        "timestampEpochMillis": {"type": "integer", "minimum": 0},
        "timestamp": {"type": "string", "format": "date-time"},
        "alarmMetaData": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "severity",
              "namespace",
              "query",
              "totalMetricsFiring",
              "dimensions",
              "metricValues",
              "alarmUrl",
              "alarmSummary",
              "notificationType"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"const": "FIRING"},
              "severity": {"enum": ["CRITICAL", "ERROR", "WARNING", "INFO"]},
              "namespace": {"const": "oci_logging_analytics"},
              "query": {"type": "string", "minLength": 1},
              "totalMetricsFiring": {"type": "integer", "minimum": 1},
              "dimensions": {
                "type": "array",
                "items": {"type": "object", "additionalProperties": {"type": "string"}}
              },
              "metricValues": {
                "type": "array",
                "items": {"type": "object", "additionalProperties": {"type": "string"}}
              },
              "alarmUrl": {"type": "string", "minLength": 1},
              "alarmSummary": {"type": "string", "minLength": 1},
              "notificationType": {"type": "string", "minLength": 1}
            }
          }
        },
        "version": {"type": "number"}
      }
    },
    "normalizedDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "detected_at",
        "rule",
        "severity",
        "source",
        "window",
        "matched_count",
        "entities",
        "mitre",
        "evidence",
        "oci_context"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "event_id": {"type": "string", "minLength": 1},
        "event_type": {"const": "oci.logan.detection"},
        "detected_at": {"type": "string", "format": "date-time"},
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "query_ref", "schedule", "lookback"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "title": {"type": "string", "minLength": 1},
            "query_ref": {"type": "string", "pattern": "^queries/"},
            "schedule": {"type": "string", "minLength": 1},
            "lookback": {"type": "string", "minLength": 1}
          }
        },
        "severity": {"enum": ["high", "critical"]},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "log_sources"],
          "properties": {
            "product": {"const": "OCI Log Analytics"},
            "log_sources": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "minLength": 1},
            "end": {"type": "string", "minLength": 1}
          }
        },
        "matched_count": {"type": "integer", "minimum": 0},
        "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "mitre": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tactics", "techniques"],
          "properties": {
            "tactics": {"type": "array", "items": {"type": "string"}},
            "techniques": {"type": "array", "items": {"type": "string"}}
          }
        },
        "evidence": {"type": "object"},
        "oci_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenancy_id", "compartment_id", "region"],
          "properties": {
            "tenancy_id": {"type": "string", "minLength": 1},
            "compartment_id": {"type": "string", "minLength": 1},
            "region": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "detectionSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_title",
        "description",
        "query_file",
        "eligible",
        "severity",
        "metric_name",
        "dimensions",
        "primary_raw_sample_ids",
        "native_alarm",
        "normalized_detection"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "display_title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "query_file": {"type": "string", "pattern": "^queries/"},
        "eligible": {"const": true},
        "severity": {"enum": ["high", "critical"]},
        "metric_name": {"type": "string", "minLength": 1},
        "dimensions": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "primary_raw_sample_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        },
        "native_alarm": {"$ref": "#/$defs/nativeAlarm"},
        "normalized_detection": {"$ref": "#/$defs/normalizedDetection"}
      }
    }
  }
}
