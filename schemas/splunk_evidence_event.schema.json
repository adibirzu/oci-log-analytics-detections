{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adibirzu/oci-log-analytics-detections/blob/main/schemas/splunk_evidence_event.schema.json",
  "title": "OCI Log Analytics Splunk Evidence Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_key", "batch_id", "detection", "evidence", "provenance"],
  "properties": {
    "schema_version": {"const": "oci.logan.splunk.evidence.v1"},
    "event_key": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "detection": {"$ref": "#/$defs/detection"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "metric_namespace", "dimensions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "metric_namespace": {"type": "string", "minLength": 1},
        "dimensions": {"type": "object", "maxProperties": 3, "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}}
      }
    },
    "evidenceField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "not": {"const": "Original Log Content"}},
        "value": {"type": ["string", "number", "integer", "boolean", "null"]}
      }
    },
    "redactedOriginalContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_field", "redacted_content"],
      "properties": {
        "source_field": {"const": "Original Log Content"},
        "redacted_content": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "originalContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redaction_profile", "records"],
      "properties": {
        "redaction_profile": {"type": "string", "minLength": 1},
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/redactedOriginalContent"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_original_content", "event_time", "log_source", "entity", "fields"],
      "properties": {
        "include_original_content": {"type": "boolean"},
        "event_time": {"type": "string", "format": "date-time"},
        "log_source": {"type": "string", "minLength": 1},
        "entity": {"type": ["string", "null"]},
        "original_content": {"$ref": "#/$defs/originalContent"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/evidenceField"}}
      },
      "allOf": [{
        "if": {"properties": {"include_original_content": {"const": true}}, "required": ["include_original_content"]},
        "then": {"required": ["original_content"]},
        "else": {"not": {"required": ["original_content"]}}
      }]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "analytics_plane", "query_file", "query_version", "window_start", "window_end"],
      "properties": {
        "product": {"const": "OCI Log Analytics"},
        "analytics_plane": {"const": "oci_log_analytics"},
        "query_file": {"type": "string", "pattern": "^queries/(?:apps/|hunting/|sentinel/)?[a-z0-9][a-z0-9_-]*\\.json$"},
        "query_version": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"}
      }
    }
  }
}
