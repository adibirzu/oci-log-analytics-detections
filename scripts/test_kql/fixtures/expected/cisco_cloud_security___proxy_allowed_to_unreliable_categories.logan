('Log Source' = 'SOC WAF Security Logs' or 'Log Source' = 'SOC Web Application Logs' or 'Log Source' = 'SOC Network Firewall Logs') and ('Event Type' = 'proxylogs') and ('Threat Category' like '*Dating*' or 'Threat Category' like '*Digital Postcards*' or 'Threat Category' like '*Freeware and Shareware*' or 'Threat Category' like '*Gambling*' or 'Threat Category' like '*Hacking*' or 'Threat Category' like '*Hunting*' or 'Threat Category' like '*Mobile Phones*' or 'Threat Category' like '*Software Updates*' or 'Threat Category' like '*URL Shortener*' or 'Threat Category' like '*Web Hosting*') and (Action = 'ALLOWED') | stats count as TotalEvents by 'Request URL', 'Source IP' | sort -TotalEvents | stats unique('Source IP') as listOfIps by 'Request URL'