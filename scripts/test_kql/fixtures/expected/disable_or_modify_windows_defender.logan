('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and (('Command Line' like '*Set-MpPreference -DisableRealtimeMonitoring $true*' or 'Command Line' like '*sc stop WinDefend*' or 'Command Line' like '*sc delete WinDefend*' or 'Command Line' like '*Set-MpPreference -DisableBehaviorMonitoring $true*' or 'Command Line' like '*Set-MpPreference -ExclusionProcess*' or 'Command Line' like '*Set-MpPreference -ExclusionExtension dll*' or 'Command Line' like '*net stop security center*'))