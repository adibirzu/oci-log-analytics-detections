('Log Source' = 'SOC Windows Sysmon Logs' or 'Log Source' = 'Windows Security Events') and (('Process Name' like '*powershell.exe*' or 'Process Name' like '*powershell_ise.exe*' or 'Process Name' like '*cmd.exe*') or 'Command Line' like '*powershell*') and (('Command Line' like '*cdn.discordapp.com*' or 'Command Line' like '*moc.ppadrocsid.ndc*')) | fields Time, 'Host Name', User, 'Process Name', 'Command Line'