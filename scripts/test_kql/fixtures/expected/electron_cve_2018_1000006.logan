('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Process Name' in ('code.exe', 'skype.exe', 'slack.exe', 'teams.exe')) and ('Parent Process Name' in ('iexplore.exe', 'runtimebroker.exe', 'chrome.exe')) and ('Command Line' like '*--gpu-launcher*') | stats min(Time) as FirstEvent, max(Time) as LastEvent by 'Host Name (Server)', 'Command Line', 'Process Name', 'Parent Process Name'