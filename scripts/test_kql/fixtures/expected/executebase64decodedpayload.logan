('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Command Line' like '*.decode(\'base64\')*' or 'Command Line' like '*.b64decode(*' or 'Command Line' like '*base64 --decode*' or 'Command Line' like '*.decode64(*') | fields Time, 'Host Name (Server)', 'Process Name', 'Target Filename', 'Command Line', 'Command Line' | sort -Time | head 100