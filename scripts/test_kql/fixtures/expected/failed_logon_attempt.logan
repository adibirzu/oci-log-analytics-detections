('Log Source' = 'Windows Security Events' or 'Log Source' = 'Windows Event Security Logs') and ('Host Name (Server)' in ('DeviceName1', 'DeviceName2')) and (Action = 'LogonFailed') | stats count as LogonFailures by 'Host Name (Server)', 'Logon Type', 'Command Line' | where LogonFailures > 3 | fields LogonFailures, 'Host Name (Server)', 'Logon Type', 'Command Line' | sort -LogonFailures