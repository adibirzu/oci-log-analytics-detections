('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and (('Command Line' like '*user*' and 'Command Line' like '*/Domain*' and 'Command Line' like '*/Active:Yes*' and 'Command Line' like '*/PasswordChg:No*')) | timestats span = 1day count as commands by Entity | where commands > 200