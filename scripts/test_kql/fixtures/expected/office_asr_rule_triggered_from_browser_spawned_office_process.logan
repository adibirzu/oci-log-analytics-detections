('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and (Action like '*Office*') and ('Parent Process Name' in ('iexplore.exe', 'chrome.exe', 'firefox.exe', 'msedge.exe') or 'Parent Process Name' in ('iexplore.exe', 'chrome.exe', 'firefox.exe', 'msedge.exe')) and (not('Process Name' like '*.docx' or 'Process Name' like '*.xlsx' or 'Process Name' like '*.pptx'))