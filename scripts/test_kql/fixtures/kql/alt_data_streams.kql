('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Command Line' like '-q -s*' and 'Command Line' like '-p*' and not(('Target Filename' like '*visual studio*' or 'Target Filename' like '*ide*'))) | timestats span = 1hour unique('Command Line') as set_ProcessCommandLine, unique('Target Filename') as set_FolderPath, unique('Command Line') as set_InitiatingProcessCommandLine by Entity