('Log Source' = 'Microsoft Defender Endpoint Network Logs' or 'Log Source' = 'SOC Sysmon Network Logs') and ('Parent Process Name' = 'cmd.exe' and 'Parent Process Name' = 'excel.exe') and ('Request URL' like '*.kr') | fields Time, 'Host Name (Server)', 'Destination IP', 'Request URL' | sort -Time | head 100