('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Process Name' = 'reg.exe') and (('Command Line' like '*save*' and 'Command Line' like '*hklm*' and 'Command Line' like '*sam*')) | fields Entity, Time, 'Process ID', 'Parent Process Name', 'Process ID', 'Process Name', 'Command Line'