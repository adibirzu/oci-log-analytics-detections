('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and (Action in ('CreateRemoteThreadApiCall', 'QueueUserApcRemoteApiCall', 'SetThreadContextRemoteApiCall')) and ('Parent Process Name' in ('winword.exe', 'excel.exe', 'powerpnt.exe')) and (not ('Command Line' like '*/dde*')) and (not(('Command Line' like '*.docx*' or 'Command Line' like '*dotx*' or 'Command Line' like '*.xlsx*' or 'Command Line' like '*.xltx*' or 'Command Line' like '*.pptx*')))