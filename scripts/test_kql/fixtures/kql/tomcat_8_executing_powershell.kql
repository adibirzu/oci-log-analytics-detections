('Log Source' = 'Microsoft Defender Endpoint Logs' or 'Log Source' = 'SOC Windows Sysmon Logs') and ('Parent Process Name' like 'tomcat*') and ('Parent Process Name' in ('cmd.exe', 'powershell.exe') and 'Command Line' like '-enc *' and ('Command Line' like '*cmd.exe*' or 'Command Line' like '*powershell.exe*' or 'Command Line' like '*sc.exe*' or 'Command Line' like '*schtasks.exe*' or 'Command Line' like '*WMIC.exe*'))